{
    "name": "coinspay/coinspay-paymenter",
    "description": "CoinsPay cryptocurrency payment gateway for Paymenter",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Paymenter\\Extensions\\Gateways\\CoinsPay\\": "CoinsPay/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
